# Copy to api/.env and `set -a; . ./.env; set +a` (or set these in your shell).
# Every value here has a working default - nothing is required to run the demo.

# --- storage ---------------------------------------------------------------
# SQLite today; point at Postgres/Supabase by swapping app/db.py's connector.
SUARASAH_DB=suarasah.db

# --- networking ------------------------------------------------------------
# Comma-separated allowed origins for the web app.
SUARASAH_CORS=http://localhost:3000,http://127.0.0.1:3000
# Set to 1 when demoing from a phone on the venue LAN (allows any origin).
SUARASAH_CORS_ALL=0

# --- rate limits (requests per minute per IP) ------------------------------
SUARASAH_RL_VERIFY=30
SUARASAH_RL_LIVE=10
SUARASAH_RL_SESSIONS=20
# Set to 1 ONLY for local evaluation runs, never for a deployment.
SUARASAH_RL_DISABLE=0

# --- tuning (defaults are the ones eval/run_eval.py was measured with) -----
SUARASAH_FP_BER=0.28
SUARASAH_RISK_MEDIUM=0.40
SUARASAH_RISK_HIGH=0.70
SUARASAH_WM_ALPHA=0.25
SUARASAH_CLIP_EXPIRY=604800

# --- optional real models (see requirements-ml.txt) ------------------------
# SUARASAH_DETECTOR_MODEL=eliya/forensics_0.3B_xlsr_wild_deepfake_classifier
# SUARASAH_WHISPER_SIZE=small
# SUARASAH_WHISPER_DEVICE=cuda
# SUARASAH_WHISPER_COMPUTE=float16

# --- scam reports ----------------------------------------------------------
# Per-deployment pepper for hashing reported phone numbers. CHANGE THIS.
SUARASAH_REPORT_PEPPER=change-me-in-production
