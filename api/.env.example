# Copy to api/.env and `set -a; . ./.env; set +a` (or set these in your shell).
# Every value here has a working default - nothing is required to run the demo.

# --- storage ---------------------------------------------------------------
# SQLite today; point at Postgres/Supabase by swapping app/db.py's connector.
SILENTVOICE_DB=silentvoice.db

# --- networking ------------------------------------------------------------
# Comma-separated allowed origins for the web app.
SILENTVOICE_CORS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
# Set to 1 when demoing from a phone on the venue LAN (allows any origin).
SILENTVOICE_CORS_ALL=0

# --- rate limits (requests per minute per IP) ------------------------------
SILENTVOICE_RL_VERIFY=30
SILENTVOICE_RL_LIVE=10
SILENTVOICE_RL_SESSIONS=20
# Set to 1 ONLY for local evaluation runs, never for a deployment.
SILENTVOICE_RL_DISABLE=0

# --- tuning (defaults are the ones eval/run_eval.py was measured with) -----
SILENTVOICE_FP_BER=0.28
SILENTVOICE_RISK_MEDIUM=0.40
SILENTVOICE_RISK_HIGH=0.70
SILENTVOICE_WM_ALPHA=0.25
SILENTVOICE_CLIP_EXPIRY=604800

# --- optional real models (see requirements-ml.txt) ------------------------
# SILENTVOICE_DETECTOR_MODEL=eliya/forensics_0.3B_xlsr_wild_deepfake_classifier
# SILENTVOICE_WHISPER_SIZE=small
# SILENTVOICE_WHISPER_DEVICE=cuda
# SILENTVOICE_WHISPER_COMPUTE=float16

# --- scam reports ----------------------------------------------------------
# Per-deployment pepper for hashing reported phone numbers. CHANGE THIS.
SILENTVOICE_REPORT_PEPPER=change-me-in-production
