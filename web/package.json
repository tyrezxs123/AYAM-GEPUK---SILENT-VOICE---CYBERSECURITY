{
  "name": "suarasah-web",
  "version": "0.1.0",
  "private": true,
  "description": "SuaraSah - mobile-first PWA: verify voice provenance, warn about AI voices",
  "scripts": {
    "dev": "next dev",
    "dev:lan": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "start:lan": "next start -H 0.0.0.0",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "dev:https": "next dev -H 0.0.0.0 --experimental-https --experimental-https-key ../certs/dev.key --experimental-https-cert ../certs/dev.crt"
  },
  "dependencies": {
    "@noble/ed25519": "2.1.0",
    "@noble/hashes": "1.6.1",
    "next": "^15.5.28",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "^5.16.4",
    "@types/node": "22.10.2",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.2"
  }
}
